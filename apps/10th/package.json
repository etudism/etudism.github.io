{
  "name": "complete-reading-story-poc",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:public": "playwright test --config playwright.public.config.ts",
    "verify:dist": "node scripts/verify-dist.mjs",
    "benchmark:mock": "npm run build && playwright test --config playwright.benchmark.config.ts",
    "benchmark:llm": "playwright test --config playwright.llm.config.ts",
    "icons": "node scripts/generate-icons.mjs",
    "smoke:llm": "playwright test --config playwright.llm.config.ts"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.84",
    "idb": "8.0.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "workbox-window": "7.4.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.6.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "fake-indexeddb": "6.2.5",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.1.4",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
  }
}
